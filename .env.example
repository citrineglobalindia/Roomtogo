# ---------------------------------------------------------------------------
# Room2Go — environment variables. Copy to .env (development) or set in your
# host's secret manager (production). NEVER commit real values.
# ---------------------------------------------------------------------------

# development | test | production. In production, demo adapters are refused.
APP_ENV=development
# true = labelled DEMO MODE (sample data, simulated payments, captured emails). Ignored in production.
DEMO_MODE=true

# PostgreSQL 14+ connection string (Neon, RDS, Supabase, self-hosted…)
DATABASE_URL=postgres://room2go:room2go@localhost:5432/room2go
# "require" = TLS with certificate verification (Neon). "no-verify" = TLS without CA check (Supabase pooler).
DATABASE_SSL=
DATABASE_POOL_MAX=10

# Public origin of the site (used in emails, canonical URLs, sitemap). No trailing slash.
PUBLIC_BASE_URL=http://localhost:3000

# Authentication (Better Auth). Generate secrets with: openssl rand -base64 48
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Signs guest booking-access cookies and hashes OTP/link tokens (>= 32 chars)
APP_SECRET=
# Require TOTP two-factor for owner accounts (defaults to true in production)
REQUIRE_OWNER_MFA=
# One-time token for /admin/setup (creates the first owner; page disappears afterwards)
SETUP_TOKEN=

# Payments: razorpay | demo | none
PAYMENT_PROVIDER=none
# Room2Go's OWN Razorpay merchant account (never the agency's). Test keys start rzp_test_, live rzp_live_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks secret for https://<domain>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
# Live keys are refused unless the owner explicitly enables this.
ALLOW_LIVE_PAYMENTS=false
# Test keys are refused in production unless explicitly allowed (e.g. a staging site)
ALLOW_TEST_PAYMENTS_IN_PRODUCTION=false

# Email: smtp | demo | none
EMAIL_PROVIDER=none
EMAIL_FROM="Room2Go <bookings@roomtogo.in>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Media storage: db (images stored in Postgres — default on Vercel) | s3 (any S3-compatible: AWS S3, Cloudflare R2, Backblaze…) | local (development only)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional public CDN base for published media; otherwise served via /media/<key>
S3_PUBLIC_BASE_URL=
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false

# Scheduled jobs: the scheduler calls /api/cron/all with "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# Analytics (consent-gated, no personal data): none | ga4 | gtm
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=

# Channel manager / PMS. Only "none" is implemented (manual entry of external bookings).
CHANNEL_PROVIDER=none

# Show the "DEMO MODE" strip across the public site while in demo mode (payment pages always label simulated payments)
SHOW_DEMO_BANNER=false
